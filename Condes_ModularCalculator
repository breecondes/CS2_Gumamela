#include <iostream>
using namespace std;

    // Addition
    double add_numbers(double num_1, double num_2) {
        return num_1 + num_2;
    }
    
    // Subtraction
    double subtract_numbers(double num_1, double num_2) {
        return num_1 - num_2;
    }
    
    // Multiplication
    double multiply_numbers(double num_1, double num_2) {
        return num_1 * num_2;
    }
    
    // Division
    double divide_numbers(double num_1, double num_2) {
        return num_1 / num_2;
    }
    
    int main() {
        double num_1, num_2;
        int choice;
        double result;
        
    // Ask for two numbers
    cout << "Enter first number: ";
    cin >> num_1;
    
    cout << "Enter second number: ";
    cin >> num_2;
    
    // Ask for operation
    cout << "\nChoose operation:\n";
    cout << "1 - Addition\n";
    cout << "2 - Subratraction\n";
    cout << "3 - Mutiplication\n";
    cout << "4 - Division\n";
    cout << "Enter choice: ";
    cin >> choice;
    
    // Perform operation
    if (choice == 1) {
        result == add_numbers(num_1, num_2);
    }
    else if (choice == 2) {
        result == subtract_numbers(num_1, num_2);
    }
    else if (choice == 3) {
        result == multiply_numbers(num_1,num_2);
    }
    else if (choice == 4) {
        if (num_2 == 0) {
            cout << "Cannot divide by zero." << endl;
            return 0;
        }
        result = divide_numbers(num_1, num_2);
    }
    else {
        cout << "Invalid choice." << endl;
        return 0;
    }
    cout << "\nResult: " << result << endl;
    
    return 0;
    }
